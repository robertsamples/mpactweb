# Copy to deploy/mpact.env and edit. Keep the real file out of git: it holds
# the access code and the cookie-signing key.

# --- what the site is called ------------------------------------------------
# The app's hostname, for Caddy's certificate (app.mpactms.org on mpactms.org).
# Use ":80" for a first run with no DNS name yet (and leave
# MPACT_SESSION_COOKIE_SECURE=false until you have one).
MPACT_SITE_ADDRESS=mpact.example.edu

# --- who may use it ---------------------------------------------------------
# 'code'  one shared access code (a teaching lab)
# 'users' named accounts, each with its own workspace
# 'email' anyone signs in with a code emailed to them (see below)
MPACT_AUTH=code
# One code, or several separated by commas (e.g. one per class). Not case-sensitive.
MPACT_ACCESS_CODE=change-this-to-something-long

# Signs login cookies. Generate once with:  openssl rand -hex 32
# If unset, the server makes one and keeps it in the data volume; set it
# explicitly if you ever run more than one instance.
MPACT_SECRET_KEY=

# --- email accounts (MPACT_AUTH=email) ---------------------------------------
# Addresses here (and subdomains) are internal: they see the class datasets
# and have no quota. Everyone else is external.
#MPACT_INTERNAL_DOMAINS=smith.edu
# Who gets the Accounts page.
#MPACT_ADMIN_EMAILS=you@smith.edu
# 'open', or 'approval' to hold outside sign-ups until an admin approves them.
#MPACT_SIGNUP=open
#MPACT_EXTERNAL_MAX_RUNS=10
#MPACT_EXTERNAL_MAX_STORAGE_MB=1024
# For links in the emails.
#MPACT_SITE_URL=https://mpact.example.edu
# The account the sign-in codes are sent from. Port 587: providers block 25/465.
#MPACT_SMTP_HOST=smtp.gmail.com
#MPACT_SMTP_PORT=587
#MPACT_SMTP_USER=you@smith.edu
#MPACT_SMTP_PASSWORD=app-password-here
#MPACT_MAIL_FROM=MPACT <you@smith.edu>

# --- because we are behind Caddy --------------------------------------------
MPACT_SESSION_COOKIE_SECURE=true
MPACT_TRUST_PROXY=true

# --- sizing -----------------------------------------------------------------
# Each analysis is its own process and a large peak table can use several GB.
# 2 on a 4-core/8GB box; 1 on a 2-core/4GB one.
MPACT_MAX_CONCURRENT_JOBS=2
MPACT_JOB_TIMEOUT_SECONDS=3600
MPACT_MAX_UPLOAD_BYTES=536870912

# Uploads and run outputs are deleted this long after a workspace was last
# touched. 30 days suits a shared code; raise it for named accounts, where a
# workspace is someone's ongoing work rather than a scratch session.
MPACT_SESSION_MAX_AGE_SECONDS=2592000

# Leave off in production: it puts exception detail in API responses.
MPACT_DEV=false
